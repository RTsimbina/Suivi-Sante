generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id            String    @id @default(cuid())
  email         String    @unique
  nom           String
  password      String
  role          String    @default("UTILISATEUR")
  actif         Boolean   @default(true)
  avatar        String?
  dernierLogin    DateTime?
  failedAttempts  Int       @default(0)
  lockoutUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  commentaires  Commentaire[]
  dossiersCrees Dossier[]  @relation("CreateurDossier")
}

model Societe {
  id        String    @id @default(cuid())
  nom       String
  adresse   String?
  telephone  String?
  email     String?
  nif       String?
  contactPrincipal String?
  baremes   Bareme[]
  dossiers  Dossier[]
  contrats  Contrat[]
  courriels Courriel[]
  assures   Assure[]
  contacts  EntrepriseContact[]
  prestataires PrestataireSociete[]
  createdAt DateTime  @default(now())
}

model Gestionnaire {
  id                  String    @id @default(cuid())
  nom                 String
  service             String
  dossiersAccueil     Dossier[] @relation("GestionnaireAccueil")
  dossiersTechnique   Dossier[] @relation("GestionnaireTechnique")
  dossiersCompta      Dossier[] @relation("GestionnaireCompta")
  createdAt           DateTime   @default(now())
}

model Contrat {
  id              String    @id @default(cuid())
  societeId       String
  societe         Societe   @relation(fields: [societeId], references: [id])
  reference       String
  budgetAnnuel    Float
  budgetUtilise   Float     @default(0)
  dateDebut       DateTime
  dateFin         DateTime
  statut          String    @default("ACTIF")
  appelsDeFonds   AppelDeFonds[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AppelDeFonds {
  id            String    @id @default(cuid())
  contratId     String
  contrat       Contrat   @relation(fields: [contratId], references: [id])
  montant       Float
  dateAppel     DateTime
  datePaiement  DateTime?
  reference     String?
  statut        String    @default("EN_ATTENTE")
  observations  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Dossier {
  id                        String       @id @default(cuid())
  numeroDossier             String       @unique
  dateReception             DateTime
  societeId                 String
  societe                   Societe      @relation(fields: [societeId], references: [id])
  beneficiaire              String
  typeDossier               String
  categorieDossier           String?
  gestionnaireAccueilId     String?
  gestionnaireAccueil       Gestionnaire? @relation("GestionnaireAccueil", fields: [gestionnaireAccueilId], references: [id])
  createurId                String?
  createur                  Utilisateur?  @relation("CreateurDossier", fields: [createurId], references: [id])
  assureId                  String?
  assure                    Assure?      @relation("AssureDossier", fields: [assureId], references: [id])
  nSS                       String?
  prestataireId             String?
  prestataire               Prestataire? @relation("PrestataireDossier", fields: [prestataireId], references: [id])
  prestataireLegacy         String?
  dateSoins                 DateTime?
  moyenPaiement             String?
  observations              String?
  dateTraitementTechnique   DateTime?
  montantReclame            Float
  montantValide             Float?
  ticketModerateur          Float?
  partPatient               Float?
  partEntreprise            Float?
  gestionnaireTechniqueId   String?
  gestionnaireTechnique     Gestionnaire? @relation("GestionnaireTechnique", fields: [gestionnaireTechniqueId], references: [id])
  motifRejet                String?
  dateReceptionDecompte     DateTime?
  datePaiement              DateTime?
  referencePaiement         String?
  montantPaye               Float?
  gestionnaireComptaId      String?
  gestionnaireCompta        Gestionnaire? @relation("GestionnaireCompta", fields: [gestionnaireComptaId], references: [id])
  statut                    String       @default("RECU")
  source                    String       @default("EXCEL")
  historique                String       @default("[]")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  commentaires              Commentaire[]
  justificatifs             Justificatif[]
  importations              ImportDossier[]
  courriel                  Courriel?
}

model Commentaire {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId    String?
  auteur      Utilisateur? @relation(fields: [auteurId], references: [id])
  contenu     String
  prive       Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Justificatif {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type        String
  nomFichier  String
  chemin      String
  tailleKo    Float?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model ImportHistorique {
  id            String   @id @default(cuid())
  source        String
  nomFichier    String
  nbLignes      Int
  nbSucces      Int      @default(0)
  nbErreurs     Int      @default(0)
  rapport       String   @default("[]")
  importePar    String?
  createdAt     DateTime @default(now())
  dossiers      ImportDossier[]
}

model Bareme {
  id              String   @id @default(cuid())
  societeId       String
  societe         Societe  @relation(fields: [societeId], references: [id])
  prestation      String
  tauxCouverture  Float
  plafond         Float
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([societeId, prestation])
}

model ImportDossier {
  id               String         @id @default(cuid())
  importId         String
  importHistorique ImportHistorique @relation(fields: [importId], references: [id])
  dossierId        String?
  dossier          Dossier?       @relation(fields: [dossierId], references: [id])
  numeroLigne      Int
  statutImport     String         @default("SUCCES")
  erreur           String?
  donnees          String         @default("{}")
}

model Assure {
  id                String     @id @default(cuid())
  societeId         String
  societe           Societe    @relation(fields: [societeId], references: [id], onDelete: Cascade)
  nom               String
  prenom            String?
  nSS               String?    @unique
  matricule         String?
  typeBeneficiaire  String     @default("ASSURE")   // ASSURE | CONJOINT | ENFANT
  assurePrincipalId String?                            // Clé de rattachement familial (ayants droit → assuré principal, géré en applicatif)
  codeFamille       String?                            // Code famille (regroupement administratif)
  dateNaissance     DateTime?
  sexe              String?
  dateEffet         DateTime?                          // Date de début de couverture
  bareme            Float?                             // Coefficient de cotisation / garantie (ex: 0.8)
  telephone         String?
  email             String?
  adresse           String?
  actif             Boolean    @default(true)
  dossiers          Dossier[]  @relation("AssureDossier")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Prestataire {
  id                String              @id @default(cuid())
  nom               String
  type              String
  telephone         String?
  email             String?
  adresse           String?
  nif               String?
  statut            String?
  rib               String?
  actif             Boolean             @default(true)
  dossiers          Dossier[]           @relation("PrestataireDossier")
  societes          PrestataireSociete[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

/// Liaison many-to-many entre Prestataire et Societe avec statut actif/inactif par société.
/// Inactif = le prestataire ne peut pas être utilisé par cette société (acte refusé automatiquement).
model PrestataireSociete {
  id            String      @id @default(cuid())
  prestataireId String
  prestataire   Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  societeId     String
  societe       Societe     @relation(fields: [societeId], references: [id], onDelete: Cascade)
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([prestataireId, societeId])
}

model Courriel {
  id              String     @id @default(cuid())
  type            String
  expediteur      String
  objet           String
  societeId       String?
  societe         Societe?   @relation(fields: [societeId], references: [id])
  beneficiaire    String?
  montant         Float?
  dateCourriel    DateTime   @default(now())
  dateSoins       DateTime?
  prestataire     String?
  statut          String     @default("RECU")
  traitePar       String?
  dateTraitement  DateTime?
  observations    String?
  dossierId       String?    @unique
  dossier         Dossier?   @relation(fields: [dossierId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model MessageBot {
  id              String   @id @default(cuid())
  canal           String
  expeditieurId   String
  expeditieurNom  String
  message         String
  reponse         String
  lu              Boolean  @default(false)
  createdAt       DateTime   @default(now())
}

model EntrepriseContact {
  id              String    @id @default(cuid())
  societeId       String
  societe         Societe   @relation(fields: [societeId], references: [id], onDelete: Cascade)
  nom             String
  prenom          String?
  fonction        String?
  telephone       String?
  email           String?
  actif           Boolean   @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
model HistoriqueParametre {
  id               String   @id @default(cuid())
  entite           String                              // Type d'entité (Bareme, Contrat, Utilisateur, Societe, etc.)
  entiteId         String                              // ID de l'enregistrement modifié
  champ            String                              // Nom du champ ou 'CREATION' / 'SUPPRESSION'
  ancienneValeur   String?                             // Valeur avant modification
  nouvelleValeur   String?                             // Valeur après modification
  modifiePar       String                              // Nom ou email de l'utilisateur
  modifieParId     String?                             // ID utilisateur (cuid)
  dateModification DateTime @default(now())

  // --- Champs enrichis pour le journal d'audit complet ---
  action           String   @default("MODIFICATION")   // CREATION | MODIFICATION | SUPPRESSION
  niveau           String   @default("STANDARD")       // INFO | STANDARD | SENSIBLE | CRITIQUE
  module           String?                             // Libellé lisible : "Barèmes", "Utilisateurs", "Prestataire/Société"
  objet            String?                             // Description de l'objet concerné (ex: "Profil utilisateur", "Soins dentaires")
  societeId        String?                             // ID société liée (pour filtre par société)
  ipAdresse        String?                             // Adresse IP de l'utilisateur
  navigateur       String?                             // User-Agent du navigateur
  sessionId        String?                             // ID de session NextAuth
  motif            String?                             // Motif / description de l'opération

  @@index([entite, entiteId])
  @@index([dateModification])
  @@index([action])
  @@index([niveau])
  @@index([modifieParId])
  @@index([societeId])
  @@index([module])
}

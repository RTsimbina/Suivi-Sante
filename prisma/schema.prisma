generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id            String    @id @default(cuid())
  email         String    @unique
  nom           String
  password      String
  role          String    @default("UTILISATEUR")
  // ─── R2 — Responsable de service ─────────────────────────────────────────
  // Portée « son service uniquement » : pour le rôle RESPONSABLE_SERVICE, le
  // service géré (ACCUEIL | TECHNIQUE | CONTROLE_MEDICAL | COMPTABILITE) borne
  // côté serveur la consultation KPI (performance, alertes, export). NULL pour
  // tous les autres rôles — la résolution du périmètre échoue (fail-closed)
  // si un RESPONSABLE_SERVICE n'a pas de service associé.
  serviceResponsable String?
  actif         Boolean   @default(true)
  // ─── Révocation des sessions (P1) ───────────────────────────────────────
  // Sessions NextAuth = JWT signé (8 h) : un jeton émis AVANT une
  // désactivation resterait valide jusqu'à expiration. sessionVersion est
  // INCRÉMENTÉE à chaque désactivation ET réactivation (PATCH actif) : tout
  // jeton dont la version ne correspond pas à celle du compte est REFUSÉ
  // côté serveur (voir src/lib/session-revocation.ts) — révocation
  // immédiate de toutes les sessions ouvertes, sans cookie ni cache.
  sessionVersion Int      @default(1)
  avatar        String?
  dernierLogin    DateTime?
  failedAttempts  Int       @default(0)
  lockoutUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt     DateTime @updatedAt
  commentaires  Commentaire[]
  dossiersCrees Dossier[]  @relation("CreateurDossier")
  // ─── KPI Collaborateurs (module « Performance des collaborateurs ») ────
  etapesKpi      EtapeTraitement[] @relation("EtapesUtilisateur")
  suspensionsKpi EtapeSuspension[] @relation("SuspensionsUtilisateur")
  objectifsKpi   ObjectifDelai[]   @relation("ObjectifsUtilisateur")
  seuilsKpi      SeuilAlerteKpi[]  @relation("SeuilsUtilisateur")
}

model Societe {
  id        String    @id @default(cuid())
  nom       String
  // Nom normalisé (minuscules, sans accents, ponctuation → espaces) — support
  // de l'unicité insensible à la casse et aux accents (index unique partiel,
  // migration 20261029100000). Même normalisation que les prestataires
  // (src/lib/prestataire-doublons.ts → normaliserNom).
  nomNormalise String?
  // Cycle de vie : une société inactive reste consultable (historique, dossiers
  // existants) mais n'accepte plus de nouveaux dossiers ni de nouveaux assurés.
  // Le frontend affiche déjà le badge (societe-detail.tsx) et la carte
  // « Sociétés actives » (use-societes-list.ts) — colonne requise.
  actif     Boolean   @default(true)
  adresse   String?
  telephone  String?
  email     String?
  nif       String?
  contactPrincipal String?
  // E-mail du contact principal (représentant de la société cliente) saisi
  // dans « Modifier la société » — sert de liaison au compte portail
  // CONTACT_ENTREPRISE (cf. src/lib/liaison-externe.ts).
  emailContactPrincipal String?
  baremes   Bareme[]
  dossiers  Dossier[]
  contrats  Contrat[]
  courriels Courriel[]
  assures   Assure[]
  contacts  EntrepriseContact[]
  prestataires PrestataireSociete[]
  modeCalculAppelFonds ModeCalculAppelFonds?
  createdAt DateTime  @default(now())

  @@index([nomNormalise])
}

model Gestionnaire {
  id                  String    @id @default(cuid())
  nom                 String
  service             String
  dossiersAccueil     Dossier[] @relation("GestionnaireAccueil")
  dossiersTechnique   Dossier[] @relation("GestionnaireTechnique")
  dossiersCompta      Dossier[] @relation("GestionnaireCompta")
  dossiersControleMedical Dossier[] @relation("GestionnaireControleMedical")
  etapesKpi           EtapeTraitement[] @relation("EtapesGestionnaire")
  createdAt           DateTime   @default(now())
}

model Contrat {
  id              String    @id @default(cuid())
  societeId       String
  societe         Societe   @relation(fields: [societeId], references: [id])
  reference       String
  // Montants en Decimal(18,2) — arithmétique exacte (plan P3 : les Float
  // produisaient des erreurs d'arrondi inacceptables en comptabilité).
  budgetAnnuel    Decimal   @db.Decimal(18, 2)
  budgetUtilise   Decimal   @default(0) @db.Decimal(18, 2)
  dateDebut       DateTime
  dateFin         DateTime
  statut          String    @default("ACTIF")
  appelsDeFonds   AppelDeFonds[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ARC-02 : index cœur — contrats par société (appels de fonds, budgets)
  @@index([societeId, statut])
}

model AppelDeFonds {
  id            String    @id @default(cuid())
  contratId     String
  contrat       Contrat   @relation(fields: [contratId], references: [id])
  montant       Decimal   @db.Decimal(18, 2)
  dateAppel     DateTime
  datePaiement  DateTime?
  reference     String?
  statut        String    @default("EN_ATTENTE")
  observations  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Dossier {
  id                        String       @id @default(cuid())
  numeroDossier             String       @unique
  dateReception             DateTime
  societeId                 String
  societe                   Societe      @relation(fields: [societeId], references: [id])
  beneficiaire              String
  typeDossier               String
  categorieDossier           String?
  gestionnaireAccueilId     String?
  gestionnaireAccueil       Gestionnaire? @relation("GestionnaireAccueil", fields: [gestionnaireAccueilId], references: [id])
  // ─── R3 — Assignation native du Contrôle médical ─────────────────────────
  // Même mécanique que Accueil/Technique/Compta : un gestionnaire de
  // référentiel (service CONTROLE_MEDICAL) peut être assigné au dossier. La
  // période KPI de contrôle médical porte cette assignation (EtapeTraitement.
  // gestionnaireId) — plus de saisie manuelle sans responsable identifié.
  gestionnaireControleMedicalId String?
  gestionnaireControleMedical   Gestionnaire? @relation("GestionnaireControleMedical", fields: [gestionnaireControleMedicalId], references: [id])
  createurId                String?
  createur                  Utilisateur?  @relation("CreateurDossier", fields: [createurId], references: [id])
  assureId                  String?
  assure                    Assure?      @relation("AssureDossier", fields: [assureId], references: [id])
  nSS                       String?
  prestataireId             String?
  prestataire               Prestataire? @relation("PrestataireDossier", fields: [prestataireId], references: [id])
  prestataireLegacy         String?
  dateSoins                 DateTime?
  moyenPaiement             String?
  observations              String?
  dateTraitementTechnique   DateTime?
  // Montants en Decimal(18,2) — voir Contrat (plan P3)
  montantReclame            Decimal    @db.Decimal(18, 2)
  montantValide             Decimal?   @db.Decimal(18, 2)
  ticketModerateur          Decimal?   @db.Decimal(18, 2)
  partPatient               Decimal?   @db.Decimal(18, 2)
  partEntreprise            Decimal?   @db.Decimal(18, 2)
  // ─── Référence du barème appliqué (P1 « Validité datée ») ────────────────
  // Fige la VERSION du barème utilisée au calcul du remboursement, avec les
  // valeurs nécessaires à la justification du montant (taux, plafond,
  // période de validité). Capturé à la création du dossier ; NULL pour les
  // dossiers antérieurs au correctif (jamais rétroactif). La capture des
  // valeurs rend la justification immédiate même si le barème évolue.
  baremeId                  String?    // version du barème appliquée
  baremePrestation          String?    // dénormalisé : prestation visée
  baremeTaux                Float?     // taux appliqué au calcul
  baremePlafond             Decimal?   @db.Decimal(18, 2)
  baremeValideDu            DateTime?  // période de validité de la version
  baremeValideAu            DateTime?
  gestionnaireTechniqueId   String?
  gestionnaireTechnique     Gestionnaire? @relation("GestionnaireTechnique", fields: [gestionnaireTechniqueId], references: [id])
  motifRejet                String?
  dateReceptionDecompte     DateTime?
  datePaiement              DateTime?
  referencePaiement         String?
  montantPaye               Decimal?   @db.Decimal(18, 2)
  gestionnaireComptaId      String?
  gestionnaireCompta        Gestionnaire? @relation("GestionnaireCompta", fields: [gestionnaireComptaId], references: [id])
  statut                    String       @default("RECU")
  source                    String       @default("EXCEL")
  historique                String       @default("[]")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  commentaires              Commentaire[]
  justificatifs             Justificatif[]
  importations              ImportDossier[]
  courriel                  Courriel?

  // ─── ARC-02 : index cœur — listes/KPI/exports et contrôle de plafond ─────
  // (societeId, statut, dateReception) : listes isolées par société + filtre
  // statut/période ; (assureId, typeDossier, dateReception) : consommation
  // annuelle par type d'acte (verifierPlafondAnnuel) ; (assureId,
  // dateReception) : consommation globale tous actes ; prestataireId :
  // jointures et filtres prestataire.
  @@index([societeId, statut, dateReception])
  @@index([assureId, typeDossier, dateReception])
  @@index([assureId, dateReception])
  @@index([prestataireId])
  etapesKpi                 EtapeTraitement[] @relation("EtapesDossier")
}

model Commentaire {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId    String?
  auteur      Utilisateur? @relation(fields: [auteurId], references: [id])
  contenu     String
  prive       Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Justificatif {
  id          String   @id @default(cuid())
  dossierId   String
  dossier     Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  type        String
  nomFichier  String
  chemin      String
  tailleKo    Float?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model ImportHistorique {
  id            String   @id @default(cuid())
  source        String
  nomFichier    String
  nbLignes      Int
  nbSucces      Int      @default(0)
  nbErreurs     Int      @default(0)
  rapport       String   @default("[]")
  importePar    String?
  createdAt     DateTime @default(now())
  dossiers      ImportDossier[]
}

model Bareme {
  id              String   @id @default(cuid())
  societeId       String
  societe         Societe  @relation(fields: [societeId], references: [id])
  prestation      String
  // tauxCouverture est un RATIO (%) — reste en Float. Le plafond est un
  // MONTANT — Decimal(18,2) (plan P3).
  tauxCouverture  Float
  plafond         Decimal  @db.Decimal(18, 2)
  description     String?
  // Statut ADMINISTRATIF (suspension/réactivation par l'opérateur) —
  // DISTINCT de la validité temporelle ci-dessous (P1 « Validité datée »).
  active          Boolean  @default(true)
  // ─── Validité datée + versionnement (P1) ────────────────────────────────
  // valideDu : début de validité OBLIGATOIRE (backfill migration = createdAt,
  // doc : un barème est réputé valide depuis sa création initiale).
  // valideAu : fin de validité FACULTATIVE — NULL = version en cours.
  // version  : n° de version par combinaison (societeId, prestation) — une
  //   modification de taux/plafond CLÔTURE la version courante (valideAu =
  //   veille du nouveau début) et CRÉE une nouvelle version : les anciens
  //   taux ne sont jamais écrasés, les remboursements passés restent
  //   justifiables. Aucun hard-delete : flag supprime.
  valideDu        DateTime @default(now())
  valideAu        DateTime?
  version         Int      @default(1)
  supprime        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([societeId, prestation, version])
  @@index([societeId, prestation, valideDu])
}

model ImportDossier {
  id               String         @id @default(cuid())
  importId         String
  importHistorique ImportHistorique @relation(fields: [importId], references: [id])
  dossierId        String?
  dossier          Dossier?       @relation(fields: [dossierId], references: [id])
  numeroLigne      Int
  statutImport     String         @default("SUCCES")
  erreur           String?
  donnees          String         @default("{}")
}

model Assure {
  id                String     @id @default(cuid())
  societeId         String
  societe           Societe    @relation(fields: [societeId], references: [id])  // Pas de cascade — la suppression de société est bloquée par l'API si des assurés existent
  nom               String
  prenom            String?
  nSS               String?    @unique
  matricule         String?
  typeBeneficiaire  String     @default("ASSURE")   // ASSURE | CONJOINT | ENFANT
  assurePrincipalId String?                            // Clé de rattachement familial (ayants droit → assuré principal, géré en applicatif)
  codeFamille       String?                            // Code famille (regroupement administratif)
  dateNaissance     DateTime?
  sexe              String?
  dateEffet         DateTime?                          // Date de début de couverture
  bareme            Float?                             // Coefficient de cotisation / garantie (ex: 0.8)
  telephone         String?
  email             String?
  adresse           String?
  actif             Boolean    @default(true)
  dossiers          Dossier[]  @relation("AssureDossier")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // ARC-02 : index cœur — listes par société, regroupements familiaux
  @@index([societeId, actif])
  @@index([codeFamille])
  @@index([assurePrincipalId])
}

model Prestataire {
  id                String              @id @default(cuid())
  code              String?             // Code prestataire interne (unicité — index partiel SQL)
  nom               String
  nomNormalise      String?             // Nom normalisé (minuscules, sans accents) pour la détection de doublons
  type              String
  telephone         String?
  email             String?
  adresse           String?
  nif               String?                             // NIF — Numéro d'Identification Fiscale
  stat              String?                             // Num STAT — Numéro Statistique (Madagascar)
  statutJuridique   String?                             // Statut juridique (référentiel centralisé — src/lib/referentiels.ts)
  statut            String?                             // Statut conventionnel (CONVENTIONNE / SUSPENDU)
  rib               String?                             // RIB / coordonnées bancaires
  iban              String?                             // IBAN international (validation mod-97), si applicable
  actif             Boolean             @default(true)
  // Dérogation ciblée aux contraintes d'unicité : doublons explicitement validés
  // par un Administrateur (ex : établissements d'un même groupe de prestataires).
  // Toujours tracée dans ExceptionDoublon + Journal d'Audit. Ne désactive pas
  // les autres contrôles ni les contraintes pour les fiches normales.
  exceptionValidee  Boolean             @default(false)
  groupePrestataireId String?
  groupePrestataire GroupePrestataire?  @relation(fields: [groupePrestataireId], references: [id])
  dossiers          Dossier[]           @relation("PrestataireDossier")
  societes          PrestataireSociete[]
  exceptionsDoublon ExceptionDoublon[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([nomNormalise])
  @@index([nif])
  @@index([stat])
  @@index([email])
  @@index([code])
  @@index([groupePrestataireId])
}

/// Groupe de prestataires : plusieurs établissements / agences d'un même
/// opérateur. Justifie les exceptions de doublon (données communes légitimes).
model GroupePrestataire {
  id           String        @id @default(cuid())
  nom          String        @unique
  description  String?
  prestataires Prestataire[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Trace de chaque exception de doublon validée par un Administrateur.
/// Ne jamais supprimer : complément structurel immuable du Journal d'Audit.
model ExceptionDoublon {
  id                     String      @id @default(cuid())
  prestataireId          String
  prestataire            Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  prestataireExistantId  String?     // Fiche déjà porteuse de la donnée (peut avoir été supprimée depuis)
  prestataireExistantNom String      // Nom conservé pour traçabilité même si la fiche existante disparaît
  champ                  String      // nif | stat | email | code | nom
  valeur                 String      // Valeur en doublon (normalisée)
  motif                  String      // Ex : appartenance au même groupe de prestataires
  contexte               String      // CREATION | MODIFICATION
  operationId            String?     // Regroupement des entrées d'audit d'une même opération
  valideParNom           String
  valideParId            String?
  valideParRole          String
  dateValidation         DateTime    @default(now())

  @@index([prestataireId])
  @@index([champ, valeur])
  @@index([operationId])
}

/// Liaison many-to-many entre Prestataire et Societe avec statut actif/inactif par société.
/// Inactif = le prestataire ne peut pas être utilisé par cette société (acte refusé automatiquement).
model PrestataireSociete {
  id            String      @id @default(cuid())
  prestataireId String
  prestataire   Prestataire @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  societeId     String
  societe       Societe     @relation(fields: [societeId], references: [id], onDelete: Cascade)
  actif         Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([prestataireId, societeId])
}

model Courriel {
  id              String     @id @default(cuid())
  type            String
  expediteur      String
  objet           String
  societeId       String?
  societe         Societe?   @relation(fields: [societeId], references: [id])
  beneficiaire    String?
  montant         Decimal?  @db.Decimal(18, 2)
  dateCourriel    DateTime   @default(now())
  dateSoins       DateTime?
  prestataire     String?
  statut          String     @default("RECU")
  traitePar       String?
  dateTraitement  DateTime?
  observations    String?
  dossierId       String?    @unique
  dossier         Dossier?   @relation(fields: [dossierId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // ARC-02 : index cœur — tri de la réception et filtrage par société
  @@index([statut, dateCourriel])
  @@index([societeId])
}

model MessageBot {
  id              String   @id @default(cuid())
  canal           String
  expeditieurId   String
  expeditieurNom  String
  message         String
  reponse         String
  lu              Boolean  @default(false)
  createdAt       DateTime   @default(now())
}

/// Session d'identification du bot (WhatsApp/Telegram/Messenger), stockée en
/// base : remplace l'ancienne Map en mémoire qui était perdue sur serverless
/// (instances multiples / redémarrages — plan P3 Vague 1).
/// Une ligne par expéditeur (numéro téléphone / chatId / senderId).
/// La liaison se fait par /verifier [NSS] et expire après 4 h.
model BotSession {
  expeditieurId  String   @id                // téléphone / chatId / senderId
  canal          String                      // WHATSAPP | TELEGRAM | MESSENGER
  assureId       String
  assureNom      String
  societeId      String
  verifieA       DateTime                    // dernière vérification NSS réussie
  expiresAt      DateTime                    // verifieA + TTL (4 h)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

model EntrepriseContact {
  id              String    @id @default(cuid())
  societeId       String
  societe         Societe   @relation(fields: [societeId], references: [id], onDelete: Cascade)
  nom             String
  prenom          String?
  fonction        String?
  telephone       String?
  email           String?
  actif           Boolean   @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

/// Modes de calcul des appels de fonds par société
model ModeCalculAppelFonds {
  id            String    @id @default(cuid())
  societeId     String    @unique
  societe       Societe   @relation(fields: [societeId], references: [id])
  mode          String    @default("DEPENSE_MENSUELLE")  // DEPENSE_MENSUELLE | FONDS_ROULEMENT | BUDGET_ANNUEL | FORMULE_SPECIFIQUE
  parametres    String    @default("{}")  // JSON : { fondsRoulement?: number, periodicite?: string, formule?: string }
  periodicite   String    @default("MENSUELLE")  // MENSUELLE | TRIMESTRIELLE | SEMESTRIELLE | PERSONNALISEE
  dateDebut     DateTime?                          // Date de début d'application
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ConfigurationEmail {
  id        String   @id @default(cuid())
  smtpHost  String
  smtpPort  Int
  smtpUser  String
  smtpPass  String
  smtpFrom  String
  emailRapportDestinataire String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoriqueParametre {
  id               String   @id @default(cuid())
  entite           String                              // Type d'entité (Bareme, Contrat, Utilisateur, Societe, etc.)
  entiteId         String                              // ID de l'enregistrement modifié
  champ            String                              // Nom du champ ou 'CREATION' / 'SUPPRESSION'
  ancienneValeur   String?                             // Valeur avant modification
  nouvelleValeur   String?                             // Valeur après modification
  modifiePar       String                              // Nom ou email de l'utilisateur
  modifieParId     String?                             // ID utilisateur (cuid)
  dateModification DateTime @default(now())

  // --- Champs enrichis pour le journal d'audit complet ---
  action           String   @default("MODIFICATION")   // CREATION | MODIFICATION | SUPPRESSION
  niveau           String   @default("STANDARD")       // INFO | STANDARD | SENSIBLE | CRITIQUE
  module           String?                             // Libellé lisible : "Barèmes", "Utilisateurs", "Prestataire/Société"
  objet            String?                             // Description de l'objet concerné (ex: "Profil utilisateur", "Soins dentaires")
  societeId        String?                             // ID société liée (pour filtre par société)
  ipAdresse        String?                             // Adresse IP de l'utilisateur
  navigateur       String?                             // User-Agent du navigateur
  sessionId        String?                             // ID de session NextAuth
  motif            String?                             // Motif / description de l'opération
  roleUtilisateur  String?                             // Rôle de l'utilisateur au moment de l'opération (figé — immuable)
  operationId      String?                             // Regroupe les lignes d'une même opération (1 opération = N champs modifiés)
  metadonnees      String?                             // JSON : contexte additionnel (exceptions de doublon validées, etc.)

  @@index([entite, entiteId])
  @@index([dateModification])
  @@index([action])
  @@index([niveau])
  @@index([modifieParId])
  @@index([societeId])
  @@index([module])
  @@index([roleUtilisateur])
  @@index([operationId])
}

// ─── Compteurs du rate limiting distribué (src/lib/rate-limit.ts) ───────────
// Une ligne = une clé de limitation (ex: "login:ip:1.2.3.4", "login:email:user@x.com").
// Le compteur est incrémenté de façon ATOMIQUE via INSERT … ON CONFLICT DO UPDATE :
// si la fenêtre (expiresAt) est expirée il repart à 1, sinon il s'incrémente.
// Les lignes expirées sont purgées périodiquement (voir pgCleanup).
// La table est aussi créée automatiquement au premier appel si absente.
model RateLimitCounter {
  key       String   @id                        // Clé complète du compteur
  count     Int      @default(0)                // Nombre d'opérations dans la fenêtre courante
  expiresAt DateTime                            // Fin de la fenêtre courante (INCR + EXPIRE)

  @@index([expiresAt])
}

/// File d'attente et journal centralisé des e-mails sortants (service de messagerie).
/// Chaque ligne = un message à envoyer, avec son statut, ses tentatives et son suivi.
model CourrielSortant {
  id          String   @id @default(cuid())
  // Destinataires (JSON : { to: [], cc: [], bcc: [] })
  destinataires         Json
  /// Premier destinataire normalisé — sert au rate-limiting et aux recherches
  destinatairePrincipal String
  sujet       String
  /// Nom du template utilisé (reinitialisation-mdp, notification, test, rapport-mensuel...) ou null si HTML brut
  template    String?
  /// Données du template (JSON) — pour audit et re-génération éventuelle
  donnees     Json?
  /// Contenus bruts (prioritaires sur le template s'ils sont définis)
  texte       String?
  html        String?
  /// Pièces jointes : [{ nom, contenuBase64, contentType }]
  piecesJointes Json?
  /// EN_ATTENTE | EN_COURS | ENVOYE | ECHEC
  statut      String   @default("EN_ATTENTE")
  tentatives  Int      @default(0)
  maxTentatives Int    @default(5)
  /// Date à partir de laquelle le message peut être retraité (backoff exponentiel)
  prochaineTentative DateTime?
  derniereErreur String?
  /// Message-ID renvoyé par le serveur SMTP (traçabilité bout en bout)
  messageId   String?
  /// 1 = urgente ... 9 = basse (ordre de traitement)
  priorite    Int      @default(5)
  /// Catégorie fonctionnelle : RESET_MDP | RAPPORT_MENSUEL | RAPPORT_PDF | TEST | NOTIFICATION
  categorie   String?
  /// Origine de la demande : route ou module appelant (audit)
  source      String?
  /// Identité de l'appelant : id utilisateur ou "api-key"
  sourceId    String?
  /// Expéditeur personnalisé éventuel ("Nom <adresse>") et Reply-To
  fromPersonnalise String?
  replyTo     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  envoyeLe    DateTime?

  /// Historique horodaté des transitions de statut de ce message
  evenements  CourrielEvenement[]

  @@index([statut, prochaineTentative])
  @@index([destinatairePrincipal, createdAt])
  @@index([categorie])
}

/// Journal d'événements du cycle de vie de chaque e-mail (rôle de la table
/// `email_events` du plan de mise en œuvre). Une ligne par transition :
/// MISE_EN_FILE, EN_COURS, ENVOYE, RETRY, ECHEC, RECUPERE — horodatée,
/// avec le Message-ID ou l'erreur SMTP associée. Alimente l'audit et le
/// suivi de délivrabilité sans écraser l'état courant du message.
model CourrielEvenement {
  id         String   @id @default(cuid())
  /// Message concerné — la purge d'un message purge son historique (cascade)
  courriel   CourrielSortant @relation(fields: [courrielId], references: [id], onDelete: Cascade)
  courrielId String
  /// Type d'événement (voir TYPES_EVENEMENT dans src/lib/mail/queue.ts)
  type       String
  /// Relais/fournisseur impliqué (resend, brevo, smtp2go…) — extension multi-fournisseurs
  fournisseur String?
  /// Détail lisible : Message-ID, erreur SMTP tronquée, date de la prochaine tentative…
  message    String?
  createdAt  DateTime @default(now())

  @@index([courrielId, createdAt])
  @@index([type, createdAt])
}

// ─── Module KPI — Performance des collaborateurs ─────────────────────────────
// Traçabilité chronologique du traitement : une ligne par PÉRIODE DE
// RESPONSABILITÉ (dossier × service), ouverte à l'entrée du dossier dans le
// service (transition du circuit ou création) et fermée à la sortie ou à la
// réaffectation. Les suspensions (attente de pièce, validation externe) sont
// posées à part pour exclure leur durée du temps actif — les retards
// imputables au collaborateur se distinguent ainsi des attentes externes.
/// Historique append-only : aucune fonction du code ne modifie une étape
/// fermée ; les corrections passent par de nouvelles lignes (source MANUEL).
model EtapeTraitement {
  id              String   @id @default(cuid())
  dossier         Dossier  @relation("EtapesDossier", fields: [dossierId], references: [id], onDelete: Cascade)
  dossierId       String
  /// ACCUEIL | TECHNIQUE | CONTROLE_MEDICAL | COMPTABILITE (voir referentiels.ts)
  service         String
  /// Compte utilisateur responsable de la période (identité KPI individuelle)
  user            Utilisateur? @relation("EtapesUtilisateur", fields: [userId], references: [id])
  userId          String?
  /// Gestionnaire assigné (entité de référentiel, sans compte) — hérité des
  /// champs gestionnaireXxxId du dossier au moment de l'étape
  gestionnaire    Gestionnaire? @relation("EtapesGestionnaire", fields: [gestionnaireId], references: [id])
  gestionnaireId  String?
  /// TRAVAIL (période nominale) | RETOUR_CORRECTION (événement, dossier renvoyé)
  type            String   @default("TRAVAIL")
  /// CIRCUIT (hook des routes) | MIGRATION (backfill historique) | MANUEL
  source          String   @default("CIRCUIT")
  statutAvant     String?
  statutApres     String?
  /// Entrée de responsabilité (affectation du dossier au service/collaborateur)
  dateAffectation DateTime
  /// Début effectif du traitement (action du responsable ; endpoint dédié ;
  /// sinon posé à la fermeture — règle documentée « traitement instantané »)
  dateDebut       DateTime?
  /// Sortie de responsabilité (transition de sortie ou réaffectation) —
  /// NULL = étape encore ouverte
  dateFin         DateTime?
  motifReaffectation String?
  motifRetour     String?
  suspensions     EtapeSuspension[]
  createdAt       DateTime @default(now())

  @@index([dossierId])
  @@index([service, dateAffectation])
  @@index([userId, dateFin])
  @@index([gestionnaireId])
}

/// Fenêtre de suspension d'une étape : la durée suspendue est EXCLUE du temps
/// actif et de la responsabilité imputable (motif obligatoire, horodatage
/// serveur, reprise datée — aucune valeur n'est modifiable après coup).
model EtapeSuspension {
  id        String   @id @default(cuid())
  etape     EtapeTraitement @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  etapeId   String
  /// Motif obligatoire (attente pièce, validation externe, autre service…)
  motif     String
  suspenduA DateTime
  /// NULL = toujours suspendu
  reprisA   DateTime?
  par       Utilisateur? @relation("SuspensionsUtilisateur", fields: [parId], references: [id])
  parId     String?

  @@index([etapeId])
}

/// Délai cible de traitement, VERSIONNÉ : toute modification ferme la version
/// en vigueur (valideAu = now) et crée une nouvelle ligne — l'historique des
/// anciennes valeurs est conservé pour recalculer les KPI d'époque.
model ObjectifDelai {
  id           String   @id @default(cuid())
  /// ACCUEIL | TECHNIQUE | CONTROLE_MEDICAL | COMPTABILITE
  service      String
  /// Restriction optionnelle à un type de dossier ; NULL = tous les types
  typeDossier  String?
  /// Délai cible en minutes (ex. ACCUEIL 30, TECHNIQUE 240, COMPTABILITE 120)
  delaiMinutes Int
  valideDu     DateTime @default(now())
  /// NULL = version en vigueur
  valideAu     DateTime?
  /// Motif du changement (tracé, exigé par la procédure interne)
  motif        String?
  creePar      Utilisateur @relation("ObjectifsUtilisateur", fields: [creeParId], references: [id])
  creeParId    String

  @@index([service, valideDu])
}

/// Seuil d'alerte configurable PAR SERVICE. Valeurs par défaut semées au
/// premier démarrage ; modifiables par les profils habilités (ADMINISTRATEUR).
model SeuilAlerteKpi {
  id          String   @id @default(cuid())
  /// Service visé, ou GLOBAL pour les seuils transverses
  service     String
  /// PROCHE_CIBLE (% du délai cible) | ACCUMULATION (nb dossiers ouverts)
  /// | DEGRADATION (points de taux de respect) | HAUSSE_RETOURS (%)
  typeAlerte  String
  valeur      Float
  modifiePar  Utilisateur? @relation("SeuilsUtilisateur", fields: [modifieParId], references: [id])
  modifieParId String?
  updatedAt   DateTime @updatedAt

  @@unique([service, typeAlerte])
  @@index([service])
}

# ─── Base de données PostgreSQL ─────────────────────────────
# Obligatoire pour le déploiement Vercel (SQLite ne fonctionne pas sur Vercel)
# Utilisez Vercel Postgres, Neon, Supabase ou tout PostgreSQL compatible
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────
# Généré avec : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth-ici"
NEXTAUTH_URL="https://votre-domaine.vercel.app"

# ─── Rate limiting partagé (Redis Upstash) ──────────────────
# RECOMMANDÉ EN PRODUCTION (Vercel/serverless) : les compteurs anti brute-force
# (login par IP, login par e-mail, webhooks) sont stockés dans Redis et partagés
# par TOUTES les instances, avec une opération atomique INCR + EXPIRE.
# Sans ces variables, un compteur mémoire local est utilisé par instance
# (suffisant en développement, contournable en production multi-instances).
# Créez une base gratuite sur https://upstash.com (Redis → connect via REST API)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Préfixe optionnel des clés Redis (utile si plusieurs applications partagent
# le même Redis). Exemple : "suivi-sante" → clé finale "suivi-sante:login:ip:1.2.3.4"
RATE_LIMIT_KEY_PREFIX=""
# Réglages optionnels (valeurs par défaut indiquées) :
LOGIN_EMAIL_LIMIT="5"             # tentatives échouées par e-mail
LOGIN_EMAIL_WINDOW_SECONDS="900"  # fenêtre : 15 minutes
LOGIN_IP_LIMIT="30"               # tentatives par IP, tous comptes confondus
LOGIN_IP_WINDOW_SECONDS="900"     # fenêtre : 15 minutes
WEBHOOK_IP_LIMIT="30"             # requêtes webhook par IP
WEBHOOK_IP_WINDOW_SECONDS="60"    # fenêtre : 1 minute

# ─── Google OAuth (optionnel) ───────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Setup Token (pour initialiser la BDD après déploiement) ─
# Généré avec : openssl rand -hex 16
# Appeler GET /api/setup?token=CE_TOKEN après le premier déploiement
SETUP_TOKEN="votre-token-setup-ici"

# ─── Email / SMTP (optionnel - pour les rapports mensuels) ──
# Vous pouvez aussi configurer SMTP directement depuis l'interface d'administration.
# La configuration en base de données est prioritaire sur ces variables.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_RAPPORT_DESTINATAIRE=""

# ─── WhatsApp Bot (optionnel) ───────────────────────────────
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
# App Secret du dashboard Meta (pour vérification HMAC-SHA256 des webhooks)
WHATSAPP_APP_SECRET=""

# ─── Telegram Bot (optionnel) ───────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Secret token pour la vérification des webhooks Telegram (Bot API 7.0+)
# Généré avec : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# ─── Messenger Bot (optionnel) ──────────────────────────────
MESSENGER_VERIFY_TOKEN=""
MESSENGER_ACCESS_TOKEN=""
# App Secret du dashboard Meta (pour vérification HMAC-SHA256 des webhooks)
MESSENGER_APP_SECRET=""

# ─── IA (LLM) ───────────────────────────────────────────────
# Requis pour l'Assistance IA et les bots
LLM_BASE_URL=https://votre-api-url.com/v1
LLM_API_KEY=votre-cle-api
LLM_MODEL=glm-4-flash

# ─── Cron (optionnel) ───────────────────────────────────────
# Activer le cron mensuel en production : true
CRON_ENABLED=""
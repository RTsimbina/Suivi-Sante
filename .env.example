# ─── Base de données PostgreSQL ─────────────────────────────
# Obligatoire pour le déploiement Vercel (SQLite ne fonctionne pas sur Vercel)
# Utilisez Vercel Postgres, Neon, Supabase ou tout PostgreSQL compatible
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────
# Généré avec : openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-nextauth-ici"
NEXTAUTH_URL="https://votre-domaine.vercel.app"

# ─── Rate limiting partagé (Redis Upstash OU PostgreSQL/Neon) ───────────────
# Les compteurs anti brute-force (login par IP, login par e-mail, webhooks)
# sont stockés dans un espace partagé et protègent toutes les instances avec
# une opération atomique INCR + EXPIRE.
#
# Backend sélectionné automatiquement ("auto", défaut) :
#   1. Redis Upstash  → si UPSTASH_REDIS_REST_URL et TOKEN sont définis
#   2. PostgreSQL     → si DATABASE_URL est défini (votre Neon : ZÉRO config
#                       supplémentaire, compteurs dans la table RateLimitCounter)
#   3. Mémoire locale → sinon (dev mono-instance uniquement, contournable)
# Forçable : RATE_LIMIT_BACKEND="redis" | "postgres" | "memory"
RATE_LIMIT_BACKEND="auto"
# Option A (latence minimale) : base Redis gratuite sur https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Préfixe optionnel des clés Redis (utile si plusieurs applications partagent
# le même Redis). Exemple : "suivi-sante" → clé finale "suivi-sante:login:ip:1.2.3.4"
RATE_LIMIT_KEY_PREFIX=""
# Réglages optionnels (valeurs par défaut indiquées) — politique à 3 niveaux
# + garde-fou (voir src/lib/login-policy.ts) :
LOGIN_EMAIL_LIMIT="5"             # niveau 1 : échecs par COMPTE (login:email:<email>)
LOGIN_EMAIL_WINDOW_SECONDS="900"  #   fenêtre : 15 minutes
LOGIN_IP_LIMIT="30"               # niveau 2 : TOUTES tentatives par IP (login:ip:<ip>)
LOGIN_IP_WINDOW_SECONDS="900"     #   fenêtre : 15 minutes
LOGIN_PAIR_LIMIT="5"              # niveau 3 : échecs par couple IP+compte (login:<ip>:<email>)
LOGIN_PAIR_WINDOW_SECONDS="900"   #   fenêtre : 15 minutes
LOGIN_GLOBAL_LIMIT="0"            # garde-fou : TOUTES tentatives (login:global) ;
                                  #   0 = désactivé (recommandé : un blocage global
                                  #   est lui-même un vecteur de déni de service)
LOGIN_GLOBAL_WINDOW_SECONDS="900"
WEBHOOK_IP_LIMIT="30"             # requêtes webhook par IP
WEBHOOK_IP_WINDOW_SECONDS="60"    # fenêtre : 1 minute

# ─── Google OAuth (optionnel) ───────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Setup Token (pour initialiser la BDD après déploiement) ─
# Généré avec : openssl rand -hex 16
# Appeler GET /api/setup?token=CE_TOKEN après le premier déploiement
SETUP_TOKEN="votre-token-setup-ici"

# ─── Email / SMTP (optionnel - pour les rapports mensuels) ──
# Vous pouvez aussi configurer SMTP directement depuis l'interface d'administration.
# La configuration en base de données est prioritaire sur ces variables.
# ⚠️ Utilisez un relais SMTP d'un domaine que vous contrôlez (voir docs/MESSAGERIE.md
#    pour les enregistrements SPF / DKIM / DMARC indispensables à la délivrabilité).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_RAPPORT_DESTINATAIRE=""

# ─── Service de messagerie centralisé (docs/MESSAGERIE.md) ──
# Clé API pour les appels machine à POST /api/mail/send et /api/mail/process
# Générer avec : openssl rand -hex 32
MAIL_API_KEY=""
# Préfixe des sujets d'e-mails
MAIL_SUBJECT_PREFIX="Suivi Santé"
# Vérification DNS/MX des domaines destinataires avant admission (true/false)
MAIL_MX_CHECK="true"
# Plafonds d'envoi (fenêtre glissante d'une heure)
MAIL_MAX_PER_RECIPIENT_HOUR="10"
MAIL_MAX_GLOBAL_HOUR="300"
# Limites par message
MAIL_MAX_RECIPIENTS="25"
MAIL_MAX_BODY_KB="512"
MAIL_MAX_ATTACHMENTS="5"
MAIL_MAX_ATTACHMENTS_KB="8192"
# Expéditeur du service de messagerie — DOIT être sur VOTRE domaine vérifié
# (noreply@ / notifications@ — jamais une adresse gmail.com personnelle).
# Utilisé par la vérification SPF / DKIM / DMARC de la page Configuration.
MAIL_FROM_EMAIL=""
# Sélecteur DKIM publié par votre relais (ex: brevo1, mail, s1...) :
MAIL_DKIM_SELECTOR="mail"
# Listes de domaines (séparées par des virgules)
MAIL_BLOCKED_DOMAINS=""
# MAIL_ALLOWED_DOMAINS=""   # si définie : liste blanche stricte
MAIL_CONTACT="support@suivisante.mg"

# ─── WhatsApp Bot (optionnel) ───────────────────────────────
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
# App Secret du dashboard Meta (pour vérification HMAC-SHA256 des webhooks)
WHATSAPP_APP_SECRET=""

# ─── Telegram Bot (optionnel) ───────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Secret token pour la vérification des webhooks Telegram (Bot API 7.0+)
# Généré avec : openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# ─── Messenger Bot (optionnel) ──────────────────────────────
MESSENGER_VERIFY_TOKEN=""
MESSENGER_ACCESS_TOKEN=""
# App Secret du dashboard Meta (pour vérification HMAC-SHA256 des webhooks)
MESSENGER_APP_SECRET=""

# ─── IA (LLM) ───────────────────────────────────────────────
# Requis pour l'Assistance IA et les bots
LLM_BASE_URL=https://votre-api-url.com/v1
LLM_API_KEY=votre-cle-api
LLM_MODEL=glm-4-flash

# ─── Cron (optionnel) ───────────────────────────────────────
# Activer le cron mensuel en production : true
CRON_ENABLED=""